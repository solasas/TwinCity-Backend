type Query {
    buildings: [Building!]!
    roads: [Road!]!
    schools: [School!]!
    hospitals: [Hospital!]!
    school(id: ID!): School
    hospital(id: ID!): Hospital
    nearestSchool(lat: Float!, lon: Float!): School
    "Live vehicle positions from the GTFS-realtime feed, refreshed on a schedule."
    vehicles: [Vehicle!]!
    "Latest weather observation for Rajahmundry, populated by the Airflow `nws_weather_ingest` DAG (Phase 2.5)."
    weather: WeatherSnapshot!
    """
    Rule-based congestion estimate for a road: fixed thresholds on how many currently-tracked
    vehicles are near it. A simple heuristic, NOT a trained model — see RoadCongestionHeuristic.
    """
    congestionLevel(roadId: ID!): String!
}

type Mutation {
    "Toggles the `open` flag on a road, simulating a closure (or reopening)."
    simulateRoadClosure(roadId: ID!): Road!
}

type Subscription {
    "Streams a vehicle each time its position changes. Call `vehicles` first for the initial snapshot."
    vehicleUpdates: Vehicle!
}

"A single WGS84 coordinate."
type GeoPoint {
    lat: Float!
    lon: Float!
}

type Building {
    id: ID!
    osmId: ID!
    name: String
    type: String
    address: String
    "Exterior ring of the building footprint polygon."
    geometry: [GeoPoint!]!
}

type Road {
    id: ID!
    osmId: ID!
    name: String
    type: String
    open: Boolean!
    "Ordered points along the road centerline."
    geometry: [GeoPoint!]!
}

type School {
    id: ID!
    osmId: ID!
    name: String
    type: String
    address: String
    location: GeoPoint!
    nearbyHospitals(withinKm: Float!): [HospitalDistance!]!
    "Only considers roads currently open (see simulateRoadClosure)."
    nearbyRoads(withinMeters: Float!): [Road!]!
}

type Hospital {
    id: ID!
    osmId: ID!
    name: String
    type: String
    address: String
    location: GeoPoint!
}

"A hospital paired with its distance from the school that was queried."
type HospitalDistance {
    id: ID!
    name: String
    type: String
    address: String
    location: GeoPoint!
    distanceKm: Float!
}

"A live transit vehicle position from the GTFS-realtime feed."
type Vehicle {
    id: ID!
    route: String
    lat: Float!
    lng: Float!
    "ISO-8601 timestamp of when this position was last updated by the feed."
    lastUpdated: String!
}

"Latest known weather conditions near Rajahmundry, sourced from Open-Meteo via the Airflow ingestion DAG."
type WeatherSnapshot {
    stationId: String!
    "ISO-8601 timestamp of the observation itself — NWS stations report roughly hourly."
    observedAt: String!
    shortForecast: String
    temperatureC: Float
    dewpointC: Float
    windDirectionDeg: Float
    windSpeedKmh: Float
    windGustKmh: Float
    barometricPressurePa: Float
    relativeHumidityPct: Float
    visibilityM: Float
    precipitationLastHourMm: Float
    "ISO-8601 timestamp of when the Airflow DAG last polled this observation."
    fetchedAt: String!
}